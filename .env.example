# Where the SQLite file lives. Default: roster.db next to app.py
DB_PATH=roster.db
# Port for local run (python app.py)
PORT=5000

# Optional: AI explanations of roster conflicts.
# Works with OpenRouter or any OpenAI-compatible API. Leave LLM_API_KEY empty
# and the app uses built-in rule-based explanations instead.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
